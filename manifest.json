{
  "manifest_version": 3,
  "name": "LinkedIn Job Sheet",
  "version": "1.0.0",
  "description": "Press Space, then M, to add the current job URL to a Google Sheet.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LinkedIn Job Sheet",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
